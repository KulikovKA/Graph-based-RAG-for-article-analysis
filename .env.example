# Настройки Docker Compose для локального запуска: docker compose --profile dev up --build.
# Скопируйте шаблон в .env и заполните секреты; реальные значения храните только в .env.
# Docker Compose читает .env автоматически; запуск Python напрямую этого не делает.
# DATABASE_URL, REDIS_URL, NEO4J_URI и QDRANT_URL задаются внутри compose.yaml.
# Qdrant и локальный Ollama в текущей конфигурации не используют пароли.

# Окружение приложения: development для разработки, production для развёртывания.
APP_ENV=development
# Уровень подробности журналов приложения.
APP_LOG_LEVEL=INFO

# Разрешить локальный HTTP; для HTTPS установите false и AUTH_COOKIE_SECURE=true.
APP_HTTP_DEV_ENABLED=true
# Точные адреса интерфейса через запятую, без завершающего слеша; порт должен совпадать с DEV_HTTP_PORT.
AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# false допустимо для локального HTTP; при использовании HTTPS установите true.
AUTH_COOKIE_SECURE=false
# Секрет подписи курсоров графа: минимум 32 случайных байта в шестнадцатеричной записи.
# Это не пароль входа. Аккаунт создаётся командой ниже, пароль вводится скрыто:
# docker compose exec api python -m app.auth_cli create user@example.org
AUTH_SESSION_SECRET=

# Имя базы PostgreSQL и пользователь приложения.
POSTGRES_DB=article_analysis
POSTGRES_USER=article_app
# Уникальный пароль PostgreSQL: минимум 32 случайных байта в шестнадцатеричной записи.
# Пароль входит в URL подключения, поэтому избегайте специальных символов URL.
# Для существующего тома PostgreSQL изменение .env само по себе не меняет пароль в базе.
POSTGRES_PASSWORD=
# Отдельный случайный пароль Redis; тот же формат, что у пароля PostgreSQL.
REDIS_PASSWORD=
# Отдельный случайный пароль Neo4j, пользователь — neo4j; тот же формат.
# Для существующего тома Neo4j изменение .env само по себе не меняет пароль в базе.
NEO4J_PASSWORD=

# Доступ к внешним источникам для corpus-runner; эти ключи нельзя сгенерировать локально.
# Ключ приложения EPO OPS из вашей учётной записи; заполняется вместе с секретом ниже.
EPO_CONSUMER_KEY=
# Секрет приложения EPO OPS; без пары ключ/секрет загрузка из EPO недоступна.
EPO_CONSUMER_SECRET=
# Ключ OpenAlex из вашей учётной записи для загрузки научных публикаций.
OPENALEX_API_KEY=

# Адрес Ollama на компьютере Windows, доступный из контейнера worker.
# Для контейнера inference с профилем cpu укажите http://inference:11434.
INFERENCE_BASE_URL=http://host.docker.internal:11434
# Пути внутри worker: ./data/models на компьютере монтируется в /models.
# Нужны заранее скачанные файлы с версиями и контрольными суммами из config/models.yaml.
# Файл токенизатора GPT-OSS; на компьютере: ./data/models/gpt-oss-tokenizer.json.
ANALYST_TOKENIZER_PATH=/models/gpt-oss-tokenizer.json
# Каталог модели повторного ранжирования Qwen; на компьютере: ./data/models/qwen3-reranker.
RERANKER_MODEL_PATH=/models/qwen3-reranker

# Предельное время одного анализа в секундах.
ANALYSIS_RUN_DEADLINE_SECONDS=1800
# Срок резервирования задания обработчиком в секундах.
ANALYSIS_JOB_LEASE_SECONDS=30
# Интервал подтверждения активности в секундах; должен быть меньше срока резервирования.
ANALYSIS_JOB_HEARTBEAT_SECONDS=5
# Интервал опроса очереди заданий в секундах.
ANALYSIS_JOB_POLL_SECONDS=1
# Максимальное количество попыток выполнения задания.
ANALYSIS_JOB_MAX_ATTEMPTS=3

# Локальный HTTP-порт интерфейса для профиля dev; доступ только с этого компьютера.
DEV_HTTP_PORT=8080
# Порт HTTP для перенаправления на HTTPS в профиле prod.
PROD_HTTP_PORT=8081
# Порт HTTPS для профиля prod; при его использовании согласуйте AUTH_ALLOWED_ORIGINS.
PROD_HTTPS_PORT=8443
# Домен Caddy для профиля prod; localhost предназначен для локальной проверки HTTPS.
PUBLIC_DOMAIN=localhost
# Адрес привязки портов профиля prod; 127.0.0.1 разрешает доступ только с этого компьютера.
# Настройка внешнего доступа описана в docs/DEPLOYMENT.md.
CADDY_BIND_ADDRESS=127.0.0.1
