# Скопируйте в .env для локальной разработки. Значения по умолчанию подходят только для временного запуска на loopback.
# Перед хранением постоянных данных замените их длинными случайными значениями, допустимыми в URL.
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HTTP_DEV_ENABLED=false
POSTGRES_DB=article_analysis
POSTGRES_USER=article_app
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NEO4J_PASSWORD=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
OPENALEX_API_KEY=
INFERENCE_BASE_URL=http://host.docker.internal:11434
# Required local, pinned GPT-OSS tokenizer and Qwen reranker assets under ./data/models.
ANALYST_TOKENIZER_PATH=/models/gpt-oss-tokenizer.json
RERANKER_MODEL_PATH=/models/qwen3-reranker
ANALYSIS_RUN_DEADLINE_SECONDS=1800
ANALYSIS_JOB_LEASE_SECONDS=30
ANALYSIS_JOB_HEARTBEAT_SECONDS=5
ANALYSIS_JOB_POLL_SECONDS=1
ANALYSIS_JOB_MAX_ATTEMPTS=3
DEV_HTTP_PORT=8080
PROD_HTTP_PORT=8081
PROD_HTTPS_PORT=8443
PUBLIC_DOMAIN=localhost
CADDY_BIND_ADDRESS=127.0.0.1
