# Copy to .env for local development. Defaults are for disposable loopback-only use.
# Replace them with long URL-safe random values before storing non-disposable data.
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HTTP_DEV_ENABLED=false
POSTGRES_DB=article_analysis
POSTGRES_USER=article_app
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NEO4J_PASSWORD=
DEV_HTTP_PORT=8080
PROD_HTTP_PORT=8081
PROD_HTTPS_PORT=8443
PUBLIC_DOMAIN=localhost
CADDY_BIND_ADDRESS=127.0.0.1
