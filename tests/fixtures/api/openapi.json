  "components": {
    "schemas": {
      "AcceptedV1": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "events_url": {
            "type": "string",
            "title": "Events Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "run_id",
          "status_url",
          "events_url"
        ],
        "title": "AcceptedV1"
      },
      "AnswerPresentationV1": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "presentation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Presentation Id"
          },
          "renderer_version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Renderer Version"
          },
          "text": {
            "type": "string",
            "maxLength": 65536,
            "title": "Text"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Text Sha256"
          },
          "chunk_count": {
            "type": "integer",
            "maximum": 128.0,
            "minimum": 1.0,
            "title": "Chunk Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "presentation_id",
          "renderer_version",
          "text",
          "text_sha256",
          "chunk_count"
        ],
        "title": "AnswerPresentationV1"
      },
      "AnswerV1": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "summary": {
            "items": {
              "$ref": "#/components/schemas/ClaimV1"
            },
            "type": "array",
            "title": "Summary"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/MatchV1"
            },
            "type": "array",
            "title": "Matches"
          },
          "differences": {
            "items": {
              "$ref": "#/components/schemas/DifferenceV1"
            },
            "type": "array",
            "title": "Differences"
          },
          "limitations": {
            "items": {
              "$ref": "#/components/schemas/LimitationV1"
            },
            "type": "array",
            "title": "Limitations"
          },
          "followup_suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Followup Suggestions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "matches",
          "differences",
          "limitations",
          "followup_suggestions"
        ],
        "title": "AnswerV1"
      },
      "ChannelCoverageV1": {
        "properties": {
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "empty",
              "unavailable",
              "disabled"
            ],
            "title": "Status"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "channel",
          "status"
        ],
        "title": "ChannelCoverageV1"
      },
      "ClaimV1": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "quotes": {
            "items": {
              "$ref": "#/components/schemas/QuoteV1"
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "title": "Quotes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "evidence_ids",
          "quotes"
        ],
        "title": "ClaimV1"
      },
      "ConversationV1": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationV1"
      },
      "CoverageV1": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceCoverageV1"
            },
            "type": "array",
            "title": "Sources"
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/ChannelCoverageV1"
            },
            "type": "array",
            "title": "Channels"
          },
          "partial": {
            "type": "boolean",
            "title": "Partial"
          },
          "historical": {
            "type": "boolean",
            "title": "Historical"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sources",
          "channels",
          "partial",
          "historical"
        ],
        "title": "CoverageV1"
      },
      "DifferenceV1": {
        "properties": {
          "feature_id": {
            "type": "string",
            "format": "uuid",
            "title": "Feature Id"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ClaimV1"
            },
            "type": "array",
            "title": "Claims"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature_id",
          "claims"
        ],
        "title": "DifferenceV1"
      },
      "EvidenceV1": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evidence Id"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Revision Id"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chunk Id"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "span_start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Span Start"
          },
          "span_end": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Span End"
          },
          "quoted_span": {
            "type": "string",
            "title": "Quoted Span"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "document_id",
          "revision_id",
