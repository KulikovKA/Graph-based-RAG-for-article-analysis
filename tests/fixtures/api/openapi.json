            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "conversations"
        ],
        "summary": "Accept Message",
        "operationId": "accept_message_api_v1_conversations__conversation_id__messages_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedV1"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "maxLength": 8192,
                    "minLength": 1,
                    "title": "Content",
                    "type": "string"
                  },
                  "expected_idea_version": {
                    "minimum": 0,
                    "title": "Expected Idea Version",
                    "type": "integer"
                  },
                  "source_run_id": {
                    "anyOf": [
                      {
                        "format": "uuid",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Source Run Id"
                  },
                  "analyze": {
                    "const": true,
                    "title": "Analyze",
                    "type": "boolean"
                  }
                },
                "required": [
                  "content",
                  "expected_idea_version",
                  "analyze"
                ],
                "title": "MessageInput",
                "type": "object"
              }
            }
          }
        }
      }
    },
