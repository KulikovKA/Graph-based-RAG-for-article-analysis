# Скопируйте в .env.secrets и ограничьте доступ средствами ОС.
# Для существующих служб переносите проверенные значения без ротации.

# Сессии приложения
AUTH_SESSION_SECRET=

# PostgreSQL приложения
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# Neo4j
NEO4J_PASSWORD=

# Общая область кэша API и worker
STAGE_CACHE_SCOPE_SECRET=

# EPO OPS: пустые значения допустимы
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# OpenAlex: пустое значение допустимо
OPENALEX_API_KEY=

# Groq: пустое значение допустимо
GROQ_API_KEY=

# Airflow
AIRFLOW_ADMIN_USERNAME=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_RUNTIME_PASSWORD=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_FERNET_KEY=

# MLflow
MLFLOW_DB_PASSWORD=
MLFLOW_DB_RUNTIME_PASSWORD=
