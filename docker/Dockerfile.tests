FROM python:3.11.16-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/app
COPY pyproject.toml README.md ./
COPY src ./src
COPY prompts ./prompts
RUN python -m pip install --no-cache-dir '.[dev]'
COPY migrations ./migrations
COPY config ./config
COPY docs/model_inventory.json ./docs/model_inventory.json
COPY alembic.ini ./
COPY tests ./tests
COPY scripts/audit_perimeter.py ./scripts/audit_perimeter.py
COPY compose.yaml Caddyfile ./
COPY docker/Caddyfile.prod ./docker/Caddyfile.prod

CMD ["pytest", "tests/integration/test_db.py"]
